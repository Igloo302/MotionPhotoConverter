        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何控制 GIF 文件大小？"
          }
        }
      }
    },
    "faqGIFFileSizeAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust quality settings in export options. Lower quality results in smaller file size but reduced image quality."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在导出选项中调整质量设置。较低的质量会产生较小的文件大小，但图像质量会降低。"
          }
        }
      }
    },
