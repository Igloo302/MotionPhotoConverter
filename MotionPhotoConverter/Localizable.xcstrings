    "faqDifferenceAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion Photos are created by Android devices, while Live Photos are Apple's format. This app converts Motion Photos to Live Photos."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动态照片由安卓设备创建，而实况照片是苹果的格式。此应用将动态照片转换为实况照片。"
          }
        }
      }
    },
    "faqDifferenceLivePhoto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What's the difference between Motion Photo and Live Photo?"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动态照片和实况照片有什么区别？"
          }
        }
      }
    },
    "faqMotionPhotoAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Motion Photo captures a few seconds of video before and after taking a photo, creating a short animated sequence."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动态照片会在拍照前后捕捉几秒钟的视频，创建一个短动画序列。"
          }
        }
      }
    },
