    "faqWhatIsMotionPhoto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is Motion Photo?"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "什么是 Motion Photo？"
          }
        }
      }
    },
    "faqWhatIsMotionPhotoAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion Photo is a dynamic photo format that captures short video clips along with static images, similar to Apple's Live Photo."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion Photo 是一种动态照片格式，在静态图像的同时捕获短视频片段，类似于苹果的 Live Photo。"
          }
        }
      }
    },
    "faqWhatIsMotionPhotoAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion Photo is a dynamic photo format that captures a short video clip along with a still image, similar to Apple's Live Photo."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion Photo 是一种动态照片格式，在静态图像的同时捕获短视频片段，类似于苹果的 Live Photo。"
          }
        }
      }
    },
    "faqWhatIsLivePhoto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is Live Photo?"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "什么是 Live Photo？"
          }
        }
      }
    },
    "faqWhatIsLivePhotoAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photo is Apple's dynamic photo format that captures 1.5 seconds before and after the moment you take a photo, creating a 3-second moving image."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photo 是苹果的动态照片格式，在拍照前后各捕获 1.5 秒，创建 3 秒的动态图像。"
          }
        }
      }
    },
    "faqAppMainFunction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What are the main functions of this app?"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个应用的主要功能是什么？"
          }
        }
      }
    },
    "faqAppMainFunctionAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convert Motion Photos to Live Photos or GIF format, support batch processing, and provide preview functionality."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 Motion Photo 转换为 Live Photo 或 GIF 格式，支持批量处理，并提供预览功能。"
          }
        }
      }
    },
    "faqHowToSelectMotionPhoto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to select Motion Photo?"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何选择 Motion Photo？"
          }
        }
      }
    },
    "faqHowToSelectMotionPhotoAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the 'Select Photos' button, choose Motion Photos from your photo library. The app will automatically identify valid Motion Photos."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击\"选择照片\"按钮，从相册中选择 Motion Photo。应用会自动识别有效的 Motion Photo。"
          }
        }
      }
    },
    "faqHowToConvertToLivePhoto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to convert Motion Photo to Live Photo?"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何将 Motion Photo 转换为 Live Photo？"
          }
        }
      }
    },
    "faqHowToConvertToLivePhotoAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After selecting Motion Photos, tap the 'Convert to Live Photo' button. The converted Live Photos will be automatically saved to your photo library."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 Motion Photo 后，点击\"转换为 Live Photo\"按钮。转换后的 Live Photo 将自动保存到相册中。"
          }
        }
      }
    },
