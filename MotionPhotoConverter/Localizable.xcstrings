    "aboutMotion2LiveDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion2Live is a professional iOS app for converting motion photos from Android devices to iOS-compatible Live Photos, GIFs, and videos."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion2Live 是一款专业的 iOS 应用，用于将 Android 设备的动态照片转换为与 iOS 兼容的实况照片、GIF 和视频。"
          }
        }
      }
    },
