      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Common reasons include insufficient storage space, photo library access permission denied, or corrupted source files."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常见原因包括存储空间不足、相册访问权限被拒绝或源文件损坏。"
          }
        }
      }
    },
    "faqLivePhotoCompatibility" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why doesn't Live Photo work on some devices?"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为什么 Live Photo 在某些设备上不起作用？"
          }
        }
      }
    },
    "faqLivePhotoCompatibilityAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photo is an Apple format, only fully supported on iOS devices and some Apple services. Other platforms may only display the still image."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photo 是苹果格式，仅在 iOS 设备和某些苹果服务上完全支持。其他平台可能只显示静态图像。"
          }
        }
      }
    },
    "faqVideoNoSound" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why is there no sound in the video?"
          }
