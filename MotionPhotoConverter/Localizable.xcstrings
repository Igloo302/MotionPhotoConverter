        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为什么视频没有声音？"
          }
        }
      }
    },
    "faqVideoNoSoundAnswer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion Photos typically don't include audio. If the original Motion Photo has audio, it will be preserved in the conversion."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion Photo 通常不包含音频。如果原始 Motion Photo 有音频，转换时会保留。"
          }
        }
      }
    },
